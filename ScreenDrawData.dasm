WallPF0
        .byte #%00010000

WallPF1
        .byte #%00000000

WallPF2
        .byte #%00000000



FloorPF0
        .byte #%11110000

FloorPF1
        .byte #%11111111

FloorPF2
        .byte #%11111111



DrawTopLeft subroutine

    lda #0 ;set background to mirrored for ceiling
    sta CTRLPF

    ;3 lines of ceiling
    lda FloorPF0
    sta PF0
    lda FloorPF1
    sta PF1
    lda FloorPF2
    sta PF2

    sta WSYNC
    sta WSYNC
    sta WSYNC
    sta WSYNC
    sta WSYNC
    sta WSYNC
    sta WSYNC

    lda #0 ;set background to none for wall
    sta CTRLPF

    ;Set to draw the wall
    lda WallPF0
    sta PF0
    lda WallPF1
    sta PF1
    lda WallPF2
    sta PF2

    ldx #183 ; X = 192 scanlines
.lvscan

    jsr DrawPlayer

    dex ; decrement X
    bne .lvscan ; repeat until 192 lines

    rts

DrawTop subroutine

    ldx #192 ; X = 192 scanlines
.lvscan

    jsr DrawPlayer

    dex ; decrement X
    bne .lvscan ; repeat until 192 lines

    rts

